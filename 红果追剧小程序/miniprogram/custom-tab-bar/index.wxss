.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  height: 110rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #eef0f3;
  box-shadow: 0 -4rpx 20rpx rgba(31, 35, 41, 0.05);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9aa0a6;
}

.tabbar__icon-wrap {
  position: relative;
  line-height: 1;
}

.tabbar__icon {
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.45;
  transition: opacity 0.15s;
}

.tabbar__item.is-active .tabbar__icon {
  opacity: 1;
}

.tabbar__text {
  margin-top: 6rpx;
  font-size: 20rpx;
}

.tabbar__item.is-active .tabbar__text {
  color: #ff4d4f;
  font-weight: 600;
}

.tabbar__badge {
  position: absolute;
  top: -10rpx;
  right: -22rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

.tabbar__dot {
  position: absolute;
  top: -4rpx;
  right: -6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
}
