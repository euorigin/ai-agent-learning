/* app.wxss — 全局样式与设计变量 */

page {
  /* 品牌色：红果系（红 / 橙） */
  --brand: #ff4d4f;
  --brand-2: #ff7a45;
  --brand-soft: rgba(255, 77, 79, 0.08);
  --ok: #0e9f6e;

  --text-1: #1f2329;
  --text-2: #646a73;
  --text-3: #9aa0a6;

  --line: #eef0f3;
  --bg: #f5f6f8;
  --card: #ffffff;

  --radius: 20rpx;
  --radius-sm: 12rpx;
  --shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.06);

  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ===== 布局 ===== */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  /* 给自定义 tabBar 让位 */
  padding-bottom: calc(150rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.container { padding: 24rpx; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.muted { color: var(--text-2); }
.dim { color: var(--text-3); }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.bold { font-weight: 600; }

/* ===== 顶部渐变头 ===== */
.hero-head {
  background: linear-gradient(160deg, #ff5a4d 0%, #ff7a45 55%, #ff9f45 100%);
  padding: 32rpx 24rpx 72rpx;
  color: #fff;
}
.hero-head__title { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-head__sub { margin-top: 8rpx; font-size: 24rpx; opacity: 0.9; }

/* ===== 区块标题 ===== */
.section { margin-bottom: 36rpx; }
.section__hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}
.section__title { font-size: 34rpx; font-weight: 700; }
.section__more { font-size: 24rpx; color: var(--text-3); }

/* ===== 数据来源标记 ===== */
.mode-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
}
.mode-pill.is-real {
  color: var(--ok);
  background: rgba(14, 159, 110, 0.10);
}

/* ===== 按钮 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
}
.btn--brand { background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: #fff; }
.btn--ghost { background: #fff; color: var(--text-2); border: 1rpx solid var(--line); }
.btn--block {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn--disabled { opacity: 0.55; }

/* ===== 卡片 / 面板 ===== */
.panel {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.panel--flat { box-shadow: none; border: 1rpx solid var(--line); }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--text-2);
  background: #f2f3f5;
}
.tag--hot { color: var(--brand); background: var(--brand-soft); }

/* ===== 空状态 ===== */
.empty { padding: 130rpx 48rpx; text-align: center; }
.empty__icon { font-size: 96rpx; line-height: 1.2; }
.empty__text { margin-top: 20rpx; font-size: 30rpx; color: var(--text-2); }
.empty__hint { margin-top: 10rpx; font-size: 24rpx; color: var(--text-3); }

/* ===== 分隔线 ===== */
.hairline { height: 1rpx; background: var(--line); }
