/* 我的追剧样式 */

.library__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  background: linear-gradient(135deg, #fff5f4, #fff9f2);
  border-bottom: 1rpx solid #f3f0ef;
}

.library__summary-main {
  display: flex;
  align-items: baseline;
}

.library__summary-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #ff4d4f;
  line-height: 1;
}

.library__summary-label {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #646a73;
}

.library__summary-tip {
  font-size: 24rpx;
  color: #ff4d4f;
}

.library__summary-tip.is-ok {
  color: #0e9f6e;
}

/* 列表项 */
.libitem {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.06);
}

.libitem__cover {
  position: relative;
  flex: none;
  width: 130rpx;
  height: 174rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.libitem__img {
  display: block;
  width: 100%;
  height: 100%;
}

.libitem__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 10rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  text-align: center;
  line-height: 1.3;
}

.libitem__dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff4d4f;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.9);
}

.libitem__body {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.libitem__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.libitem__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.libitem__progress {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #646a73;
}

.libitem__update {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.08);
}

.libitem__action {
  flex: none;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #9aa0a6;
  background: #f2f3f5;
}

/* 工具区 */
.library__tools {
  display: flex;
  margin-top: 10rpx;
}

.library__tool {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
}

.library__tool + .library__tool {
  margin-left: 20rpx;
}

.library__note {
  margin-top: 20rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #9aa0a6;
  line-height: 1.6;
}

.empty__btn {
  display: inline-flex;
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
}
