# ============================================================================
#  游戏角色 NPC Agent · 环境变量模板
#  用法：复制本文件为 `.env`，填入下面三项即可接入真实大模型。
#  只填这三项就够：NPC_LLM_BASE_URL / NPC_LLM_MODEL / NPC_LLM_API_KEY
# ============================================================================

# ---------------------------------------------------------------------------
# 一、大模型（OpenAI 兼容协议，任何兼容端点都能用）
# ---------------------------------------------------------------------------
# 例：官方 OpenAI      https://api.openai.com/v1
#     DeepSeek         https://api.deepseek.com/v1        模型 deepseek-chat
#     通义千问         https://dashscope.aliyuncs.com/compatible-mode/v1
#     月之暗面 Kimi    https://api.moonshot.cn/v1          模型 moonshot-v1-8k
#     智谱 GLM         https://open.bigmodel.cn/api/paas/v4
#     本地 Ollama      http://127.0.0.1:11434/v1           模型 qwen2.5:7b（key 随便填）
NPC_LLM_BASE_URL=
NPC_LLM_MODEL=
NPC_LLM_API_KEY=

# 模型调用参数（一般不用改）
NPC_LLM_TIMEOUT=45
NPC_LLM_MAX_TOKENS=800
NPC_LLM_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# 二、引擎与降级
# ---------------------------------------------------------------------------
# auto  = 配了上面三项就用大模型，否则自动走离线演示脑
# llm   = 强制用大模型（未配置会报错）
# demo  = 强制离线演示脑：不用任何 API Key 也能完整演示「理解→决策→工具→表现」
# rules = 纯规则降级（同 demo，语义上强调不使用任何模型）
NPC_ENGINE=auto

# ---------------------------------------------------------------------------
# 三、上下文预算（文档 §7 成本控制）
# ---------------------------------------------------------------------------
NPC_SHORT_TERM_TURNS=8
NPC_SHORT_TERM_TOKEN_BUDGET=1200
NPC_RECALL_TOP_K=5

# ---------------------------------------------------------------------------
# 四、工具安全（文档 §3.9 工具层：频率限制）
# ---------------------------------------------------------------------------
NPC_TOOL_RATE_LIMIT=12
NPC_TOOL_RATE_WINDOW=60

# ---------------------------------------------------------------------------
# 五、表现（文档 §3.8：单句台词长度上限）
# ---------------------------------------------------------------------------
NPC_MAX_UTTERANCE_CHARS=120

# ---------------------------------------------------------------------------
# 六、服务
# ---------------------------------------------------------------------------
NPC_HOST=127.0.0.1
NPC_PORT=8080
