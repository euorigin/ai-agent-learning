# 复制本文件为 .env，然后填入你的大模型 API Key 即可
#   cp .env.example .env      （Windows: copy .env.example .env）

# ---- 必填：OpenAI 兼容接口 ----
TRAVEL_LLM_BASE_URL=https://api.deepseek.com/v1
TRAVEL_LLM_MODEL=deepseek-chat
TRAVEL_LLM_API_KEY=

# ---- 其他厂商示例（换掉上面三行即可） ----
# 阿里云百炼:  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# 月之暗面:    https://api.moonshot.cn/v1                          moonshot-v1-32k
# 智谱 GLM:    https://open.bigmodel.cn/api/paas/v4                glm-4-plus
# 火山方舟:    https://ark.cn-beijing.volces.com/api/v3            推理接入点 ID
# OpenAI:      https://api.openai.com/v1                           gpt-4o-mini
# 本地 Ollama: http://localhost:11434/v1                           qwen2.5:14b-instruct

# ---- 可选：高德地图 Key（填了中国境内坐标与路线更准） ----
AMAP_KEY=

# ---- 运行模式：auto(默认) | llm | demo | rules ----
TRAVEL_ENGINE=auto

# ---- 端口（默认 8000） ----
TRAVEL_PORT=8000
